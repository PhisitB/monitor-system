# Copy to .env (git-ignored) and fill in. Leave empty for local-only mode.
# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. NEVER commit or put in web/.
SUPABASE_SECRET_KEY=
# Name of this machine in the dashboard
DEVICE_ID=notebook
